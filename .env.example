# Neon pooled PostgreSQL URL used by the application at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Neon direct PostgreSQL URL used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js secret used to protect sessions and tokens
# Generate the real value with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-characters"
