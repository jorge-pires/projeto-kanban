generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid()) @db.VarChar(30)
  name         String        @db.VarChar(80)
  email        String        @unique @db.VarChar(320)
  passwordHash String        @db.VarChar(60)
  projects     Project[]
  authAttempts AuthAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Project {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(240)
  color       String   @default("blue") @db.VarChar(20)
  ownerId     String   @db.VarChar(30)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerId, updatedAt])
}

model Task {
  id          String    @id @default(cuid()) @db.VarChar(30)
  title       String    @db.VarChar(100)
  description String    @default("") @db.VarChar(500)
  status      String    @default("todo") @db.VarChar(20)
  priority    String    @default("medium") @db.VarChar(10)
  position    Int       @default(0)
  dueDate     DateTime?
  projectId   String    @db.VarChar(30)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([projectId, status, position])
}

model AuthAttempt {
  id             String   @id @default(cuid()) @db.VarChar(30)
  action         String   @db.VarChar(20)
  identifierHash String   @db.Char(64)
  attempts       Int      @default(1)
  resetAt        DateTime
  userId         String?  @db.VarChar(30)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([action, identifierHash])
  @@index([resetAt])
  @@index([userId])
}
